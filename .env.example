# Copy this file to .env and fill in your values.
# All variables are optional — defaults are shown.

# ── Server ────────────────────────────────────────────────────────────────────
RILOG_PORT=3030
RILOG_HOST=0.0.0.0

# ── Storage (per-file) ────────────────────────────────────────────────────────
RILOG_LOGS_DIR=./logs
RILOG_FORMAT=ndjson          # ndjson | json | txt
RILOG_MAX_FILE_SIZE_MB=10
RILOG_TIMEZONE=UTC           # IANA timezone, e.g. Europe/Kyiv

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
RILOG_CORS_ORIGINS=https://your-app.example.com,https://app2.example.com

# ── Dashboard auth ────────────────────────────────────────────────────────────
RILOG_AUTH_ENABLED=true
RILOG_AUTH_PASSWORD=change-me-please

# ── Storage monitoring ────────────────────────────────────────────────────────
# Total size threshold across ALL projects combined
RILOG_MAX_TOTAL_SIZE_MB=1024        # 1 GB default

# How often to check (in hours)
RILOG_STORAGE_CHECK_INTERVAL_HOURS=1

# What to do when the threshold is exceeded:
#   warn          — print a warning to stdout/logs (default)
#   cleanup       — delete oldest log files until size drops to 80% of threshold
#   email         — send an email alert (requires SMTP settings below)
#   cleanup+email — both cleanup and email
RILOG_ON_EXCEEDED=warn

# ── SMTP (only needed when RILOG_ON_EXCEEDED includes "email") ────────────────
RILOG_SMTP_HOST=smtp.gmail.com
RILOG_SMTP_PORT=587
RILOG_SMTP_SECURE=false             # true for port 465 (SSL)
RILOG_SMTP_USER=you@gmail.com
RILOG_SMTP_PASS=your-app-password   # Gmail: use an App Password, not your main password
RILOG_SMTP_FROM=rilog@your-company.com
RILOG_SMTP_TO=admin@your-company.com

RILOG_MAX_REQUEST_SIZE_MB=20
